# === Serwer ===
PORT=3000
HOST=0.0.0.0

# === Autoryzacja serwis-do-serwisu (serwis WhatsApp -> agent) ===
# Wygeneruj: openssl rand -hex 32
SERVICE_TOKEN=

# === Dostawca LLM ===
ANTHROPIC_API_KEY=

# === Bundle (prompty, narzedzia, manifest) ===
# secretsmanager = produkcja/staging, local = dev i eval (czyta ./bundle)
BUNDLE_SOURCE=secretsmanager
# prod | staging | dev
BUNDLE_ALIAS=prod
SECRET_ID=
BUNDLE_REFRESH_SECONDS=300
# Tylko przy BUNDLE_SOURCE=local
# BUNDLE_DIR=./bundle

# === AWS (lokalnie; na produkcji uzyj roli IAM zamiast kluczy) ===
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# === API zamowien (konto tylko do odczytu) ===
ORDERS_API_URL=
ORDERS_API_TOKEN=

# === Przekazanie do czlowieka (opcjonalnie) ===
HANDOFF_WEBHOOK_URL=

# === Tracing: zostaw wylaczony (prompty i dane klientow trafilyby do zewnetrznego systemu) ===
LANGSMITH_TRACING=false
